# Unraid / Docker Compose variables for the SearXNG fork.
#
# Copy this file to .env and edit it. Do not commit .env.

# Unraid appdata folder mounted at /etc/searxng.
SEARXNG_CONFIG=/mnt/user/appdata/searxng

# Display name for this SearXNG instance.
INSTANCE_NAME=SearXNG

# Public/LAN URL of this instance, using binhex-delugevpn's published port.
# Example: http://192.168.1.106:8888/
SEARXNG_BASE_URL=http://YOUR-UNRAID-IP:8888/

# Required. Generate with: openssl rand -hex 32
# This must match Yonder's SEARXNG_SECRET.
SEARXNG_SECRET=
